# Site Configuration
# The public URL of your website (e.g., https://your-domain.com)
# Required for Stripe callbacks and absolute URL generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication
# Secret key for signing session cookies. Generate a strong random string.
JWT_SECRET=your_super_secret_random_string

# Vercel Blob Storage
# Required for storing images and content JSON files.
# Get this from your Vercel Project > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_...

# Stripe Payments
# Required for processing booking payments.
# Get this from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...

# Database (Vercel Postgres)
# Required for storing booking records.
# Get this from Vercel Project > Storage > Postgres
POSTGRES_URL=postgres://...
POSTGRES_PRISMA_URL=postgres://...
DATABASE_URL=postgres://...

# Cloudinary
# Required for image/video uploads and media storage.
# Get these from Cloudinary Console > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=beautyhomebysuzain
